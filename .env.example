# Copy to .env and fill in. Loaded by backend/api/config.py
# and by docker-compose.yml. .env is git-ignored; never commit real credentials.

# Required: Google Places API (New) key.
GOOGLE_PLACES_API_KEY=

# Required: Postgres container settings, read by docker-compose.yml.
POSTGRES_USER=hangry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hangry
POSTGRES_PORT=5432

# Required: session records. Must match the POSTGRES_* values above
# (postgresql+asyncpg://USER:PASSWORD@localhost:PORT/DB).
# Create the tables with: uv run python -m alembic -c backend/alembic.ini upgrade head
DATABASE_URL=postgresql+asyncpg://hangry:change-me@localhost:5432/hangry

# Optional: "prod" turns off /docs, /redoc and /openapi.json. Defaults to "dev".
ENVIRONMENT=dev

# Optional: proxies in front of the app that append to X-Forwarded-For. 1 = Cloud Run alone
# (default), 2 = Cloudflare -> Cloud Run. See client_ip in backend/api/ratelimit.py.
TRUSTED_PROXY_COUNT=2

# Optional: rate limits, 0 turns one off. "IP" = requests per minute per client IP;
# "SESSION" = requests per session over the 30-minute results lifetime. Defaults shown.
# Photos and searches are billed Google requests, so they are the tightest.
RATE_LIMIT_PHOTO_IP_PER_MIN=60
RATE_LIMIT_PHOTO_SESSION=40
RATE_LIMIT_SEARCH_IP_PER_MIN=20
RATE_LIMIT_SEARCH_SESSION=10
RATE_LIMIT_SESSION_CREATE_IP_PER_MIN=10
RATE_LIMIT_AUTOCOMPLETE_IP_PER_MIN=60
RATE_LIMIT_CITY_LOOKUP_IP_PER_MIN=20
