# Copy to .env and fill in. Loaded by packages/api/src/api/core/config.py.

# Required: Google Places API (New) key.
GOOGLE_PLACES_API_KEY=

# Optional for now: nothing in the API uses the DB or Claude yet.
# Matches the Postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://hangry:hangry@localhost:5432/hangry
