{
  "components": {
    "schemas": {
      "CityLocation": {
        "properties": {
          "formatted_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Formatted Address"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "title": "Lng",
            "type": "number"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "lat",
          "lng",
          "formatted_address"
        ],
        "title": "CityLocation",
        "type": "object"
      },
      "CityPrediction": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "description"
        ],
        "title": "CityPrediction",
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "initial_query": {
            "maxLength": 100,
            "title": "Initial Query",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocationInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "enum": [
              "solo",
              "group"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "mode",
          "initial_query"
        ],
        "title": "CreateSessionRequest",
        "type": "object"
      },
      "GroupResult": {
        "properties": {
          "no_likes": {
            "title": "No Likes",
            "type": "boolean"
          },
          "tallies": {
            "items": {
              "$ref": "#/components/schemas/PlaceTally"
            },
            "title": "Tallies",
            "type": "array"
          },
          "winner": {
            "$ref": "#/components/schemas/RestaurantOut"
          }
        },
        "required": [
          "winner",
          "no_likes",
          "tallies"
        ],
        "title": "GroupResult",
        "type": "object"
      },
      "GroupStatus": {
        "description": "The whole group state for one member. `GET .../group` returns it and the SSE stream pushes\nit on every change, so the client handles both the same way.",
        "properties": {
          "me": {
            "$ref": "#/components/schemas/MeOut"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberOut"
            },
            "title": "Members",
            "type": "array"
          },
          "phase": {
            "enum": [
              "lobby",
              "swiping",
              "done"
            ],
            "title": "Phase",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GroupResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "phase",
          "me",
          "members",
          "result"
        ],
        "title": "GroupStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JoinRequest": {
        "properties": {
          "craving": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Craving"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "JoinRequest",
        "type": "object"
      },
      "JoinResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "participant_id": {
            "title": "Participant Id",
            "type": "string"
          }
        },
        "required": [
          "participant_id",
          "name"
        ],
        "title": "JoinResponse",
        "type": "object"
      },
      "LocationInput": {
        "properties": {
          "formatted_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Formatted Address"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "title": "Lng",
            "type": "number"
          },
          "place_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,256}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "LocationInput",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "craving": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Craving"
          },
          "is_host": {
            "title": "Is Host",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "submitted": {
            "title": "Submitted",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "craving",
          "is_host",
          "submitted"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MemberOut": {
        "description": "What other members see about a member. No id, no craving.",
        "properties": {
          "is_host": {
            "title": "Is Host",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "submitted": {
            "title": "Submitted",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "is_host",
          "submitted"
        ],
        "title": "MemberOut",
        "type": "object"
      },
      "PhotoOut": {
        "description": "Credit Google requires wherever the photo is shown. The image itself is served at\n`GET /sessions/{id}/restaurants/{place_id}/photo`.",
        "properties": {
          "author_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author Name"
          },
          "author_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author Uri"
          }
        },
        "required": [
          "author_name",
          "author_uri"
        ],
        "title": "PhotoOut",
        "type": "object"
      },
      "PlaceTally": {
        "properties": {
          "disliked_by": {
            "items": {
              "type": "string"
            },
            "title": "Disliked By",
            "type": "array"
          },
          "dislikes": {
            "title": "Dislikes",
            "type": "integer"
          },
          "liked_by": {
            "items": {
              "type": "string"
            },
            "title": "Liked By",
            "type": "array"
          },
          "likes": {
            "title": "Likes",
            "type": "integer"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          }
        },
        "required": [
          "place_id",
          "score",
          "likes",
          "dislikes",
          "liked_by",
          "disliked_by"
        ],
        "title": "PlaceTally",
        "type": "object"
      },
      "RestaurantOut": {
        "description": "User-facing details of one candidate; internal fields (scores, ids of members) stay out.",
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "cuisine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cuisine"
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance M"
          },
          "maps_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maps Uri"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "price_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Level"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "rating_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating Count"
          }
        },
        "required": [
          "place_id",
          "name",
          "address",
          "cuisine",
          "rating",
          "rating_count",
          "price_level",
          "distance_m",
          "maps_uri",
          "photo"
        ],
        "title": "RestaurantOut",
        "type": "object"
      },
      "ResultsResponse": {
        "description": "All candidates, best first. The client shows the first 3, then the rest on request.",
        "properties": {
          "restaurants": {
            "items": {
              "$ref": "#/components/schemas/RestaurantOut"
            },
            "title": "Restaurants",
            "type": "array"
          }
        },
        "required": [
          "restaurants"
        ],
        "title": "ResultsResponse",
        "type": "object"
      },
      "SearchRequest": {
        "description": "The setup answers, sent in one call after the last setup page.",
        "properties": {
          "after": {
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "coffee_dessert",
              "drinks"
            ],
            "title": "After",
            "type": "string"
          },
          "dietary": {
            "default": "none",
            "enum": [
              "none",
              "vegetarian",
              "vegan",
              "halal"
            ],
            "title": "Dietary",
            "type": "string"
          },
          "minutes": {
            "maximum": 60.0,
            "minimum": 5.0,
            "title": "Minutes",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "walk",
              "drive"
            ],
            "title": "Mode",
            "type": "string"
          },
          "price_levels": {
            "default": [],
            "items": {
              "maximum": 4.0,
              "minimum": 1.0,
              "type": "integer"
            },
            "title": "Price Levels",
            "type": "array"
          }
        },
        "required": [
          "after",
          "mode",
          "minutes"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          }
        },
        "required": [
          "count"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "mode": {
            "enum": [
              "solo",
              "group"
            ],
            "title": "Mode",
            "type": "string"
          },
          "participant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Id"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "share_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Url"
          }
        },
        "required": [
          "session_id",
          "mode",
          "share_url",
          "participant_id"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SubmitVotesRequest": {
        "description": "One vote for every place in the member's deck; the service rejects an incomplete deck.",
        "properties": {
          "votes": {
            "items": {
              "$ref": "#/components/schemas/VoteIn"
            },
            "maxItems": 200,
            "title": "Votes",
            "type": "array"
          }
        },
        "required": [
          "votes"
        ],
        "title": "SubmitVotesRequest",
        "type": "object"
      },
      "UpdateMemberRequest": {
        "description": "Lobby edits. Rejected with 409 once the host has started.",
        "properties": {
          "craving": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Craving"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "UpdateMemberRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoteIn": {
        "properties": {
          "place_id": {
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "title": "Place Id",
            "type": "string"
          },
          "value": {
            "maximum": 5.0,
            "minimum": -5.0,
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "place_id",
          "value"
        ],
        "title": "VoteIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Hangry API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/places/autocomplete": {
      "get": {
        "operationId": "autocomplete_api_places_autocomplete_get",
        "parameters": [
          {
            "in": "query",
            "name": "input",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Input",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "session_token",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CityPrediction"
                  },
                  "title": "Response Autocomplete Api Places Autocomplete Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Autocomplete",
        "tags": [
          "places"
        ]
      }
    },
    "/api/places/cities/{place_id}": {
      "get": {
        "operationId": "city_location_api_places_cities__place_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "place_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,256}$",
              "title": "Place Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "session_token",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityLocation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "City Location",
        "tags": [
          "places"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "create_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/end": {
      "post": {
        "description": "Host only: submit for everyone still swiping (no votes) and show the result.",
        "operationId": "end_session_api_sessions__session_id__end_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-participant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Participant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "End Session",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/sessions/{session_id}/events": {
      "get": {
        "operationId": "group_events_api_sessions__session_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "participant_id",
            "required": true,
            "schema": {
              "title": "Participant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Group Events",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/sessions/{session_id}/group": {
      "get": {
        "description": "The same snapshot the event stream pushes; the fallback after a reconnect or a refocus.",
        "operationId": "group_status_api_sessions__session_id__group_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-participant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Participant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Group Status",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/sessions/{session_id}/join": {
      "post": {
        "operationId": "join_session_api_sessions__session_id__join_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
